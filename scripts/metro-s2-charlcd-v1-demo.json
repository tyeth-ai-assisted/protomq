{
  "name": "Metro S2 16x2 Character LCD V1 Demo",
  "description": "Tests MCP23008-based 16x2 I2C character LCD on Metro ESP32-S2 using V1 protocol. V1 devices send flat-field checkinRequest (id 30), not nested checkin.request envelope.",
  "protoVersion": "v1",
  "steps": [
    {
      "name": "checkin-response",
      "description": "Respond to V1 device checkin (flat field checkinRequest at id 30)",
      "trigger": "checkinRequest",
      "response": {
        "checkinResponse": {
          "response": "RESPONSE_OK",
          "totalGpioPins": 20,
          "totalAnalogPins": 4,
          "referenceVoltage": 2.5
        }
      }
    },
    {
      "name": "add-display",
      "description": "Configure the 16x2 character LCD via I2C at 0x20 (MCP23008 backpack)",
      "after": "checkin-response",
      "delay": 2000,
      "topic": "display",
      "send": {
        "display": {
          "add": {
            "type": "DISPLAY_CLASS_CHAR_LCD",
            "driver": "charlcd",
            "panel": "charlcd16x2default",
            "name": "charlcd16x2default",
            "i2c": {
              "deviceAddress": 32,
              "busSda": "D33",
              "busScl": "D34"
            },
            "configCharLcd": {
              "columns": 16,
              "rows": 2
            },
            "write": {
              "name": "charlcd16x2default",
              "message": "Hello ProtoMQ!"
            }
          }
        }
      }
    },
    {
      "name": "write-hello",
      "description": "Write a test message to the LCD",
      "after": "add-display",
      "delay": 3000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "charlcd16x2default",
            "message": "Hello ProtoMQ!\nMetro S2 LCD"
          }
        }
      }
    },
    {
      "name": "write-update",
      "description": "Write an updated status message",
      "after": "write-hello",
      "delay": 5000,
      "topic": "display",
      "send": {
        "display": {
          "write": {
            "name": "charlcd16x2default",
            "message": "LCD 0x20 ready\n16x2 V1 Test OK"
          }
        }
      }
    }
  ]
}
